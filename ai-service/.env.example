# =====================================================================
# AgriGrade AI — Environment Variables & Production Configuration
# =====================================================================

# 1. Official Government Mandi Price API (Open Government Data - data.gov.in)
# Register and obtain API key from: https://data.gov.in/
DATA_GOV_API_KEY=
MARKET_DATA_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MARKET_DATA_SOURCE=data.gov.in
MARKET_REFRESH_ENABLED=true
MARKET_REFRESH_HOUR=6
MARKET_REFRESH_MINUTE=0
MARKET_CACHE_MAX_AGE_HOURS=24
MARKET_REQUEST_TIMEOUT_SECONDS=20
MARKET_REQUEST_RETRIES=3

# 2. Multimodal Gemini Vision API (Google AI Studio)
GEMINI_API_KEY=

# 3. Microservice Network Endpoints
SPRING_BOOT_GATEWAY_URL=http://localhost:8090
SPRING_BOOT_CORE_URL=http://localhost:8080
FASTAPI_PORT=5000
FRONTEND_PORT=3001
